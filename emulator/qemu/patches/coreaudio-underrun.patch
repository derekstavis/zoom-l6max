+/* QEMU exits on SIGTERM without closing voices, so also finish at exit. */
+static CoreaudioVoiceOut *capture_voice;
+
+static void coreaudio_capture_finish(void)
+{
+    CoreaudioVoiceOut *core = capture_voice;
+
+    capture_voice = NULL;
+    if (!core || !core->capture) {
+        return;
+    }
+    error_report("coreaudio: capture finalized; callback_frames=%" PRIu64
+                 " captured_frames=%zu underruns=%" PRIu64
+                 " device_mismatches=%" PRIu64,
+                 core->callback_frames, core->capture_frames,
+                 core->underruns, core->device_mismatches);
+    fwrite(core->capture_data, core->hw.info.bytes_per_frame,
+           core->capture_frames, core->capture);
+    fclose(core->capture);
+    core->capture = NULL;
 }
 
