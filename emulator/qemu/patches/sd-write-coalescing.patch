+#define SD_PENDING_SIZE (256 * KiB)
+
+static void sd_blk_flush_pending(SDState *sd)
+{
+    if (!sd->pending_len) {
+        return;
+    }
+    if (!sd->blk || blk_pwrite(sd->blk, sd->pending_start, sd->pending_len,
+                               sd->pending, 0) < 0) {
+        fprintf(stderr, "sd_blk_write: write error on host side\n");
+    }
+    sd->pending_len = 0;
+}
+
+/*
+ * With the drive's write cache enabled, WRITE_MULTIPLE_BLOCK collects
+ * contiguous blocks and writes them together when the transfer ends, when
+ * the next command arrives, or when the VM stops. Every read goes through a
+ * command first, so the guest never sees stale data. Without the write
+ * cache, each block is written as it arrives.
+ */
+static void sd_blk_write_multiple(SDState *sd, uint64_t addr, uint32_t len)
+{
+    if (!sd->pending || !blk_enable_write_cache(sd->blk)) {
+        sd_blk_flush_pending(sd);
+        sd_blk_write(sd, addr, len);
+        return;
+    }
+
+    trace_sdcard_write_block(addr, len);
+    addr += sd_part_offset(sd);
+    if (sd->pending_len &&
+        (addr != sd->pending_start + sd->pending_len ||
+         sd->pending_len + len > SD_PENDING_SIZE)) {
+        sd_blk_flush_pending(sd);
+    }
+    if (!sd->pending_len) {
+        sd->pending_start = addr;
+    }
+    memcpy(sd->pending + sd->pending_len, sd->data, len);
+    sd->pending_len += len;
+}
+
+static void sd_vm_state_change(void *opaque, bool running, RunState state)
+{
+    if (!running) {
+        sd_blk_flush_pending(opaque);
+    }
+}
